{
  "compilerOptions": {
    /* ================= Compiler target ================= */
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "moduleResolution": "node",

    /* ================= Project structure ================= */
    "rootDir": "./src",
    "outDir": "./dist",

    /* ================= Type safety ================= */
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* ================= JS interoperability ================= */
    "esModuleInterop": true,
    "resolveJsonModule": true,

    /* ================= Source maps ================= */
    "sourceMap": true,

    /* ================= Declarations ================= */
    "declaration": false,
    "declarationMap": false,

    /* ================= Path aliases ================= */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },

  /* ================= Files ================= */
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
