# Database
# Reemplaza 'serobles' con tu usuario de PostgreSQL
# Si tu PostgreSQL requiere contraseña, usa: postgresql://usuario:contraseña@localhost:5432/apa_db
DATABASE_URL=postgresql://serobles@localhost:5432/apa_db

# Server
PORT=3000
NODE_ENV=development

# Two Factor
TWO_FACTOR_CODE_EXPIRY_MINUTES=10

# Deep Linking
APP_DEEP_LINK_SCHEME=exp
WEB_FALLBACK_URL=http://localhost:8081
SERVER_HOST=192.168.1.39:8081
